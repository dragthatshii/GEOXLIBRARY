--[[
    GEOXLIBRARY
    Usage:
        local Library = loadstring(game:HttpGet("YOUR_RAW_GIST_URL"))()
        local Window = Library:CreateWindow({ Name = "GEOXLIBRARY", Accent = Color3.fromRGB(255, 200, 50) })
]]

local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local Library = {}
Library.__index = Library

local DefaultTheme = {
    Bg     = Color3.fromRGB(18, 18, 18),
    Card   = Color3.fromRGB(28, 28, 28),
    Stroke = Color3.fromRGB(40, 40, 40),
    Text   = Color3.fromRGB(220, 220, 220),
    Dim    = Color3.fromRGB(140, 140, 140),
    Accent = Color3.fromRGB(255, 200, 50),
    Drop   = Color3.fromRGB(35, 35, 35),
    Check  = Color3.fromRGB(45, 45, 45),
}

local function corner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = p
    return c
end

local function stroke(p, col, th)
    local s = Instance.new("UIStroke")
    s.Color = col or DefaultTheme.Stroke
    s.Thickness = th or 1
    s.Parent = p
    return s
end

function Library:CreateWindow(opts)
    opts = opts or {}
    local theme = {}
    for k, v in pairs(DefaultTheme) do theme[k] = v end
    if opts.Accent then theme.Accent = opts.Accent end
    if opts.Theme then
        for k, v in pairs(opts.Theme) do theme[k] = v end
    end

    local self = setmetatable({
        Theme = theme,
        Tabs = {},
        Pages = {},
        TabButtons = {},
        Visible = true,
    }, Library)

    pcall(function()
        if CoreGui:FindFirstChild("GEOXLIBRARY_UI") then
            CoreGui.GEOXLIBRARY_UI:Destroy()
        end
    end)

    local gui = Instance.new("ScreenGui")
    gui.Name = "GEOXLIBRARY_UI"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = CoreGui
    self.Gui = gui

    local main = Instance.new("Frame")
    main.Name = "Main"
    main.Size = UDim2.new(0, opts.Width or 520, 0, opts.Height or 440)
    main.Position = UDim2.new(0.5, -((opts.Width or 520) / 2), 0.5, -((opts.Height or 440) / 2))
    main.BackgroundColor3 = theme.Bg
    main.BorderSizePixel = 0
    main.Parent = gui
    corner(main, 12)
    stroke(main, Color3.fromRGB(50, 50, 50), 1)
    self.Main = main

    local dragging, dragStart, startPos
    local dragHit = Instance.new("Frame")
    dragHit.Size = UDim2.new(1, 0, 0, 50)
    dragHit.BackgroundTransparency = 1
    dragHit.Parent = main
    dragHit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    dragHit.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)

    local logoBar = Instance.new("Frame")
    logoBar.Size = UDim2.new(0, 4, 0, 18)
    logoBar.Position = UDim2.new(0, 16, 0, 14)
    logoBar.BackgroundColor3 = theme.Accent
    logoBar.BorderSizePixel = 0
    logoBar.Parent = main
    corner(logoBar, 2)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(0, 260, 0, 20)
    title.Position = UDim2.new(0, 26, 0, 10)
    title.BackgroundTransparency = 1
    title.Text = opts.Name or "GEOXLIBRARY"
    title.Font = Enum.Font.GothamBlack
    title.TextSize = 18
    title.TextColor3 = Color3.fromRGB(245, 245, 245)
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = main

    local subtitle = Instance.new("TextLabel")
    subtitle.Size = UDim2.new(0, 260, 0, 12)
    subtitle.Position = UDim2.new(0, 26, 0, 28)
    subtitle.BackgroundTransparency = 1
    subtitle.Text = opts.Subtitle or "LIBRARY"
    subtitle.Font = Enum.Font.GothamBold
    subtitle.TextSize = 10
    subtitle.TextColor3 = theme.Accent
    subtitle.TextXAlignment = Enum.TextXAlignment.Left
    subtitle.Parent = main

    local tabBar = Instance.new("Frame")
    tabBar.Name = "TabBar"
    tabBar.Size = UDim2.new(1, -24, 0, 34)
    tabBar.Position = UDim2.new(0, 12, 0, 48)
    tabBar.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
    tabBar.BorderSizePixel = 0
    tabBar.Parent = main
    corner(tabBar, 8)
    stroke(tabBar)
    self.TabBar = tabBar

    local tabLayout = Instance.new("UIListLayout")
    tabLayout.FillDirection = Enum.FillDirection.Horizontal
    tabLayout.Padding = UDim.new(0, 4)
    tabLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    tabLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    tabLayout.Parent = tabBar

    if opts.ToggleKey ~= false then
        local key = opts.ToggleKey or Enum.KeyCode.RightShift
        UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.KeyCode == key then
                self:Toggle()
            end
        end)
    end

    return self
end

function Library:CreateTab(name)
    local theme = self.Theme

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 90, 0, 26)
    btn.BackgroundTransparency = 1
    btn.Text = name
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.TextColor3 = theme.Dim
    btn.AutoButtonColor = false
    btn.Parent = self.TabBar

    local page = Instance.new("ScrollingFrame")
    page.Name = name
    page.Size = UDim2.new(1, -24, 1, -96)
    page.Position = UDim2.new(0, 12, 0, 90)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 4
    page.ScrollBarImageColor3 = theme.Stroke
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.Parent = self.Main

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 10)
    list.Parent = page

    self.Pages[name] = page
    self.TabButtons[name] = btn

    btn.MouseButton1Click:Connect(function()
        self:SelectTab(name)
    end)

    local count = 0
    for _ in pairs(self.Pages) do count = count + 1 end
    if count == 1 then self:SelectTab(name) end

    local tabApi = {}

    function tabApi:CreateSection(title)
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, 0, 0, 0)
        card.AutomaticSize = Enum.AutomaticSize.Y
        card.BackgroundColor3 = theme.Card
        card.BorderSizePixel = 0
        card.Parent = page
        corner(card, 10)
        stroke(card)

        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0, 12)
        pad.PaddingRight = UDim.new(0, 12)
        pad.PaddingTop = UDim.new(0, 10)
        pad.PaddingBottom = UDim.new(0, 12)
        pad.Parent = card

        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 8)
        layout.Parent = card

        local header = Instance.new("TextLabel")
        header.Size = UDim2.new(1, 0, 0, 18)
        header.BackgroundTransparency = 1
        header.Text = title
        header.Font = Enum.Font.GothamMedium
        header.TextSize = 14
        header.TextColor3 = theme.Text
        header.TextXAlignment = Enum.TextXAlignment.Left
        header.Parent = card

        local section = {}

        function section:CreateToggle(cfg)
            cfg = cfg or {}
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 24)
            row.BackgroundTransparency = 1
            row.Parent = card

            local box = Instance.new("TextButton")
            box.Size = UDim2.new(0, 18, 0, 18)
            box.Position = UDim2.new(0, 0, 0.5, -9)
            box.BackgroundColor3 = theme.Check
            box.Text = ""
            box.AutoButtonColor = false
            box.Parent = row
            corner(box, 4)
            stroke(box)

            local check = Instance.new("TextLabel")
            check.Size = UDim2.new(1, 0, 1, 0)
            check.BackgroundTransparency = 1
            check.Text = "✓"
            check.TextColor3 = theme.Accent
            check.TextSize = 14
            check.Font = Enum.Font.GothamBold
            check.Visible = cfg.Default == true
            check.Parent = box

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -28, 1, 0)
            label.Position = UDim2.new(0, 26, 0, 0)
            label.BackgroundTransparency = 1
            label.Text = cfg.Name or "Toggle"
            label.Font = Enum.Font.Gotham
            label.TextSize = 13
            label.TextColor3 = theme.Text
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = row

            local state = cfg.Default == true
            box.MouseButton1Click:Connect(function()
                state = not state
                check.Visible = state
                if cfg.Callback then cfg.Callback(state) end
            end)

            return {
                Set = function(_, v)
                    state = v and true or false
                    check.Visible = state
                end,
                Get = function() return state end,
            }
        end

        function section:CreateSlider(cfg)
            cfg = cfg or {}
            local min = cfg.Min or 0
            local max = cfg.Max or 100
            local default = cfg.Default or min

            local wrap = Instance.new("Frame")
            wrap.Size = UDim2.new(1, 0, 0, 42)
            wrap.BackgroundTransparency = 1
            wrap.Parent = card

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(0.7, 0, 0, 16)
            lbl.BackgroundTransparency = 1
            lbl.Text = cfg.Name or "Slider"
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 12
            lbl.TextColor3 = theme.Dim
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = wrap

            local valLbl = Instance.new("TextLabel")
            valLbl.Size = UDim2.new(0.3, 0, 0, 16)
            valLbl.Position = UDim2.new(0.7, 0, 0, 0)
            valLbl.BackgroundTransparency = 1
            valLbl.Text = string.format("%.1f", default)
            valLbl.Font = Enum.Font.GothamMedium
            valLbl.TextSize = 12
            valLbl.TextColor3 = theme.Text
            valLbl.TextXAlignment = Enum.TextXAlignment.Right
            valLbl.Parent = wrap

            local track = Instance.new("Frame")
            track.Size = UDim2.new(1, 0, 0, 6)
            track.Position = UDim2.new(0, 0, 0, 24)
            track.BackgroundColor3 = theme.Drop
            track.BorderSizePixel = 0
            track.Parent = wrap
            corner(track, 3)

            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(math.clamp((default - min) / (max - min), 0, 1), 0, 1, 0)
            fill.BackgroundColor3 = theme.Accent
            fill.BorderSizePixel = 0
            fill.Parent = track
            corner(fill, 3)

            local sliding = false
            local function setFromX(x)
                local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                local v = min + rel * (max - min)
                v = math.floor(v * 10 + 0.5) / 10
                fill.Size = UDim2.new(rel, 0, 1, 0)
                valLbl.Text = string.format("%.1f", v)
                if cfg.Callback then cfg.Callback(v) end
            end

            track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    sliding = true
                    setFromX(input.Position.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                    setFromX(input.Position.X)
                end
            end)
        end

        function section:CreateButton(cfg)
            cfg = cfg or {}
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, 0, 0, 30)
            b.BackgroundColor3 = theme.Drop
            b.Text = cfg.Name or "Button"
            b.TextColor3 = theme.Text
            b.TextSize = 13
            b.Font = Enum.Font.GothamMedium
            b.AutoButtonColor = false
            b.Parent = card
            corner(b, 6)
            stroke(b)
            b.MouseButton1Click:Connect(function()
                if cfg.Callback then cfg.Callback() end
            end)
            b.MouseEnter:Connect(function() b.BackgroundColor3 = Color3.fromRGB(42, 42, 42) end)
            b.MouseLeave:Connect(function() b.BackgroundColor3 = theme.Drop end)
            return b
        end

        function section:CreateLabel(text)
            local l = Instance.new("TextLabel")
            l.Size = UDim2.new(1, 0, 0, 18)
            l.BackgroundTransparency = 1
            l.Text = text or ""
            l.Font = Enum.Font.Gotham
            l.TextSize = 12
            l.TextColor3 = theme.Dim
            l.TextXAlignment = Enum.TextXAlignment.Left
            l.Parent = card
            return l
        end

        return section
    end

    return tabApi
end

function Library:SelectTab(name)
    for n, page in pairs(self.Pages) do
        page.Visible = (n == name)
        if self.TabButtons[n] then
            self.TabButtons[n].TextColor3 = (n == name) and self.Theme.Text or self.Theme.Dim
        end
    end
end

function Library:Toggle()
    self.Visible = not self.Visible
    self.Main.Visible = self.Visible
end

function Library:Destroy()
    pcall(function() self.Gui:Destroy() end)
end

return Library
